# Borea Live: a standalone installer image, built from upstream sources.
# Toolchain and target
BR2_x86_64=y
# A prebuilt Bootlin glibc toolchain (GCC, C++, glibc) instead of compiling one
# first: the single biggest saving on a first build. Plain x86-64, so the image
# runs on any 64-bit PC.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_STABLE=y
BR2_CCACHE=y
BR2_CCACHE_DIR="$(BASE_DIR)/../ccache"
# Lets borea-build run independent packages side by side (top-level `make -j`).
BR2_PER_PACKAGE_DIRECTORIES=y

# System
BR2_TARGET_GENERIC_HOSTNAME="borea-live"
BR2_TARGET_GENERIC_ISSUE="Borea Live"
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_MERGED_USR=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_TARGET_GENERIC_GETTY_PORT="tty2"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BOREA_PATH)/board/borea/rootfs-overlay"
# The live session's user, in the image itself: the root filesystem is read-only,
# and tmpfiles needs the user while the image is being made.
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_BOREA_PATH)/board/borea/users.table"
# Both hooks are borea-build, linked here by `borea-build iso`.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BOREA_PATH)/../../target/live/hooks/post-build"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_BOREA_PATH)/../../target/live/hooks/post-image"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_TARGET_TZ_INFO=y

# Kernel: upstream's latest, x86-64 defaults plus Borea's hardware coverage
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BOREA_PATH)/board/borea/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Firmware and microcode for common Wi-Fi, Bluetooth, GPUs, and CPUs
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_RADEON=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_XE=y
BR2_PACKAGE_LINUX_FIRMWARE_IBT=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7260=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8000C=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_QUZ=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA9377=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_11K_WCN6855=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y
BR2_PACKAGE_INTEL_MICROCODE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMD_UCODE=y

# Graphics: Mesa for Intel, AMD, NVIDIA (nouveau), VMs, and software rendering
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_I915=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_NOUVEAU=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y

# The installer's session
BR2_PACKAGE_CAGE=y
BR2_PACKAGE_LIBXKBCOMMON=y
# The keymaps themselves: without them cage has no keyboard at all
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_POLKIT=y
BR2_PACKAGE_DBUS_BROKER=y

# Networking
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Disks
BR2_PACKAGE_UDISKS=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
# borea-worker runs in a private mount namespace
BR2_PACKAGE_UTIL_LINUX_UNSHARE=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
# The installer formats EFI partitions, and checks them
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_GPTFDISK=y
# Native tools borea-installd runs on the live host (crates/borea-exec preflight).
# borea-build's dropped-option check fails the build if Buildroot rejects any of these.
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_BTRFS_PROGS=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_NTFS_3G_NTFSPROGS=y
BR2_PACKAGE_GNUPG2=y
BR2_PACKAGE_EFIBOOTMGR=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL_BIN=y

# Borea itself
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_HOST_RUST_BIN=y
BR2_PACKAGE_BOREA=y

# Busybox stays only for the unsigned early boot's rescue shell.
BR2_PACKAGE_BUSYBOX=y

# The image: an EROFS root, mounted straight from its file by borea-init, inside a
# hybrid BIOS/UEFI ISO booted by Limine
BR2_TARGET_ROOTFS_EROFS=y
# LZMA through "custom": the plain LZMA choice is also named like Buildroot's
# generic BR2_TARGET_ROOTFS_<FS>_LZMA switch, which then wraps the whole image
# in an unused rootfs.erofs.lzma at lzma -9 (minutes of single-threaded work).
BR2_TARGET_ROOTFS_EROFS_CUSTOM_COMPRESSION=y
BR2_TARGET_ROOTFS_EROFS_COMPRESSION_ALGORITHMS="lzma,6"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_XORRISO=y
BR2_PACKAGE_HOST_LIMINE=y
