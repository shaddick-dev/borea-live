# Live ISO only. Probes the hardware once per boot, before the installer UI starts.
# The GPU drivers the live session uses (i915/xe, amdgpu, nouveau) must be loaded first so
# /sys/class/drm shows which GPU drives the built-in screen; udev-settle covers that.
[Unit]
Description=Borea: detect hardware and plan drivers
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service
Before=borea-installer.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/borea-probe --write /run/borea/hardware.json
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
